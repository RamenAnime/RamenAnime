# ─── Database ─────────────────────────────────────────────────────────────────
  # TiDB Cloud (MySQL-compatible). Get your connection string from the TiDB console.
  DATABASE_URL=mysql://username:password@host:4000/database?ssl=true

  # ─── App Credentials ──────────────────────────────────────────────────────────
  # Used to sign JWT session tokens. Must be at least 32 characters.
  APP_ID=ramen-anime-prod
  APP_SECRET=change-me-to-a-random-secret-at-least-32-chars

  # ─── Email (Resend) ───────────────────────────────────────────────────────────
  # Get a free API key at https://resend.com
  # Required for email verification and password reset emails.
  RESEND_API_KEY=re_your_resend_api_key

  # ─── Site URL ─────────────────────────────────────────────────────────────────
  # Used to build links in emails (password reset, email verification).
  SITE_URL=https://ramenanime.com

  # ─── Stripe Connect ───────────────────────────────────────────────────────────
  # Required for marketplace payments and seller payouts.
  # 1. Sign up at https://dashboard.stripe.com/register
  # 2. Get keys from https://dashboard.stripe.com/apikeys
  # 3. Enable Connect at https://dashboard.stripe.com/settings/connect
  # 4. Add a webhook endpoint pointing to /api/stripe/webhook
  STRIPE_SECRET_KEY=sk_live_...
  STRIPE_PUBLISHABLE_KEY=pk_live_...
  STRIPE_WEBHOOK_SECRET=whsec_...

  # ─── Vite Public Variables ────────────────────────────────────────────────────
  # These are embedded into the frontend bundle at build time.
  VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
  VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key

  # ─── Optional: reCAPTCHA (Recommended) ───────────────────────────────────────
  # Protects login and registration from bots.
  # Get keys at https://www.google.com/recaptcha/admin
  RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key

  # ─── Optional: Google Custom Search ──────────────────────────────────────────
  # Used by the AI price analysis feature.
  GOOGLE_API_KEY=your_google_api_key
  GOOGLE_CX=your_custom_search_engine_id

  # ─── Optional: Auto-Promote Admin ─────────────────────────────────────────────
  # Set this to your OAuth union ID to grant yourself admin on first login.
  OWNER_UNION_ID=your_union_id

  # ─── Optional: Admin Migration Key ───────────────────────────────────────────
  # Required to call the /api/run-migration endpoint.
  ADMIN_MIGRATION_KEY=change-me-to-a-secure-random-string

  # ─── Node Environment ─────────────────────────────────────────────────────────
  NODE_ENV=production
  