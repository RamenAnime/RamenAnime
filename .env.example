# Database
DATABASE_URL=mysql://username:password@host:3306/database

# App credentials (used for JWT session signing)
APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here_at_least_32_chars

# SMTP Email (Gmail, Outlook, etc.)
SMTP_FROM="Ramen Anime <noreply@ramenanime.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: reCAPTCHA bot protection
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Optional: custom search API for AI price analysis
GOOGLE_API_KEY=your_search_api_key
GOOGLE_CX=your_custom_search_engine_id

# Optional: listing image copyright (vision + reverse-image APIs)
GOOGLE_VISION_API_KEY=your_cloud_vision_api_key
TINEYE_API_KEY=
TINEYE_API_SECRET=

# Optional: auto-promote this OAuth union ID to admin
OWNER_UNION_ID=your_owner_union_id

# Public site URL (checkout redirects, emails). No trailing slash.
SITE_URL=https://ramenanime.com

# Node environment
NODE_ENV=development

# Stripe Connect (marketplace payments)
# Dashboard: https://dashboard.stripe.com
# Enable Connect, then add webhook: POST https://YOUR_DOMAIN/api/stripe/webhook
# Events: checkout.session.completed, account.updated
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
